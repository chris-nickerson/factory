#!/usr/bin/env python3
"""Factory command line."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
if os.name != "posix":
    sys.exit("Software Factory requires a POSIX environment. Use macOS or Linux.")
if sys.version_info < (3, 11):
    sys.exit("Software Factory needs Python 3.11 or later")
sys.path.insert(0, str(Path(__file__).resolve().parent))


def main():
    import comparison
    import dialogue
    import doctor
    import evidence
    import plan
    import rounds
    from installation import render_update, update
    from workspace import inspect, repo_root

    parser = argparse.ArgumentParser(
        description="Discover a checkout, capture verification, and coordinate engineering work."
    )
    parser.add_argument(
        "--version",
        action="version",
        version="software-factory 0.1.0 (local evidence schema 1)",
    )
    sub = parser.add_subparsers(dest="command", required=True)
    scan = sub.add_parser(
        "inspect",
        help="Find repository instructions, skills, and suggested commands without running project code",
    )
    scan.add_argument("--repo", default=".")
    scan.add_argument(
        "--path",
        action="append",
        default=[],
        help="Affected path, relative to the checkout root",
    )

    def discover(args):
        location = Path(args.repo).resolve()
        root = repo_root(location)
        return inspect(root, [location.relative_to(root), *args.path]), 0

    scan.set_defaults(action=discover)

    upgrade = sub.add_parser(
        "update", help="Install the latest Factory from its origin's main branch"
    )
    upgrade.add_argument(
        "--json", action="store_true", help="Print a machine-readable report"
    )
    upgrade.set_defaults(action=update, render=render_update)
    comparison.register(sub)
    doctor.register(sub)
    evidence.register(sub)
    plan.register(sub)

    dialogue.register(sub)
    rounds.register(sub)
    args = parser.parse_args()
    pretty = hasattr(args, "render") and not args.json and sys.stdout.isatty()
    color = pretty and not os.environ.get("NO_COLOR")
    if pretty and sys.stderr.isatty():
        args.progress = lambda text: print(
            f"\r\033[K  {text}…", end="", file=sys.stderr, flush=True
        )
    try:
        if hasattr(args, "action"):
            report, code = args.action(args)
            clear_progress(args)
            print(args.render(report, color) if pretty else json.dumps(report, indent=2))
            return code
        return args.func(args)
    except subprocess.CalledProcessError as exc:
        message = exc.stderr or b""
        if isinstance(message, bytes):
            message = message.decode(errors="replace")
        error = message.strip() or str(exc)
    except (ValueError, OSError, RuntimeError, TypeError, KeyError) as exc:
        error = str(exc)
    clear_progress(args)
    if pretty:
        title = "\033[31m✘\033[0m \033[1mUpdate blocked\033[0m" if color else "✘ Update blocked"
        print(f"\n  {title}", file=sys.stderr)
        for line in error.removeprefix("fatal: ").splitlines():
            print(f"    {line}", file=sys.stderr)
        print(file=sys.stderr)
    else:
        print(json.dumps(dict(status="BLOCKED", error=error)), file=sys.stderr)
    return 2


def clear_progress(args):
    if getattr(args, "progress", None):
        print("\r\033[K", end="", file=sys.stderr, flush=True)


if __name__ == "__main__":
    sys.exit(main())
